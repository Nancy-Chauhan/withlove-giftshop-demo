@inject IProductService ProductService

@if (_segments.Count > 0)
{
    @foreach (var segment in _segments)
    {
        @switch (segment.Type)
        {
            case ChatMessageContentParser.SegmentType.Product when segment.Product is { } product:
                <article class="my-3 overflow-hidden rounded-xl border border-stone-100 bg-stone-50 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl"
                             alt="@product.Name"
                             class="h-44 w-full object-cover"
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="flex h-28 items-center justify-center bg-stone-100 text-stone-300" aria-label="No image available">
                            <span class="material-symbols-outlined text-3xl">image</span>
                        </div>
                    }
                    <div class="space-y-1 p-3">
                        <div class="flex items-baseline justify-between gap-3">
                            <h4 class="font-display text-base font-medium text-stone-800">@product.Name</h4>
                            <span class="shrink-0 font-medium text-primary">$@product.Price.ToString("F2")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(product.Description))
                        {
                            <p class="text-sm leading-relaxed text-stone-600">@product.Description</p>
                        }
                    </div>
                </article>
                break;

            case ChatMessageContentParser.SegmentType.Image:
                <img src="@segment.Url"
                     alt="@segment.Alt"
                     class="my-2 max-h-48 max-w-full rounded-lg border border-stone-100 object-cover shadow-sm"
                     loading="lazy" />
                break;

            default:
                @((MarkupString)FormatText(segment.Content))
                break;
        }
    }
}

@code {
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    private IReadOnlyList<ChatMessageContentParser.Segment> _segments = [];
    private string? _loadedText;

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedText, Text, StringComparison.Ordinal))
            return;

        _loadedText = Text;
        var parsed = ChatMessageContentParser.Parse(Text);
        var productSegments = parsed
            .Where(segment => segment.Type == ChatMessageContentParser.SegmentType.Product
                && segment.Product is not null)
            .ToArray();

        if (productSegments.Length == 0)
        {
            _segments = parsed;
            return;
        }

        IReadOnlyList<WithLove.Web.Models.Product> catalog;
        try
        {
            catalog = await ProductService.GetProductsAsync();
        }
        catch
        {
            catalog = [];
        }

        if (!string.Equals(_loadedText, Text, StringComparison.Ordinal))
            return;

        _segments = parsed.Select(segment =>
        {
            if (segment.Product is not { } product)
                return segment;

            var canonical = ChatMessageContentParser.FindCatalogProduct(product, catalog);
            return segment with
            {
                Product = ChatMessageContentParser.Canonicalize(product, canonical),
            };
        }).ToArray();
    }

    /// <summary>Formats ordinary assistant prose while keeping it HTML-encoded.</summary>
    private static string FormatText(string text)
    {
        if (string.IsNullOrEmpty(text))
            return "";

        var encoded = System.Net.WebUtility.HtmlEncode(text);
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded,
            @"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)",
            "<em>$1</em>");
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded,
            @"`(.+?)`",
            "<code class=\"bg-stone-100 px-1 py-0.5 rounded text-xs font-mono\">$1</code>");
        return encoded.Replace("\n", "<br />");
    }
}
